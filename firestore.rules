rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isRole(role) {
      return isAuthenticated() && (
        request.auth.token.role == role ||
        getUserData().role == role
      );
    }

    function isAdmin() {
      return isRole('admin');
    }

    function isSupervisor() {
      return isRole('supervisor') || isAdmin();
    }

    function isMaintenance() {
      return isRole('maintenance') || isRole('technician') || isSupervisor();
    }

    function isTaskOwner(task) {
      return isAuthenticated() && (
        task.get('assignedTo', null) == request.auth.uid ||
        request.auth.uid in task.get('assignedToIds', []) ||
        (
          request.auth.token.get('email', null) != null &&
          task.get('assignedTo', null) == request.auth.token.get('email', null)
        )
      );
    }

    function isTaskBroadcast(task) {
      return task.get('isBroadcast', false) == true;
    }

    function canMaintenanceReadTask(task) {
      return isMaintenance() && (
        isTaskOwner(task) ||
        isTaskBroadcast(task)
      );
    }

    function canMaintenanceUpdateTask() {
      return canMaintenanceReadTask(resource.data) &&
        isTaskOwner(request.resource.data) &&
        request.resource.data.get('isBroadcast', false) == false &&
        request.resource.data.get('inspectionStatus', null) != 'approved' &&
        request.resource.data.get('inspectionStatus', null) != 'flagged' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'assignedTo',
          'assignedToIds',
          'isBroadcast',
          'assignmentType',
          'assignedAt',
          'acknowledgedAt',
          'acknowledgedBy',
          'completedAt',
          'completedBy',
          'submissions',
          'checklist',
          'remarks',
          'beforePhotoUrl',
          'beforePhotoCapturedAt',
          'afterPhotoUrl',
          'afterPhotoCapturedAt',
          'additionalPhotos',
          'biometricVerified',
          'offlineSynced',
          'inspectionStatus',
          'workDuration',
          'totalTime',
          'recheckCount',
          'recheckedBy',
          'recheckedAt',
          'updatedAt'
        ]);
    }

    match /tasks/{taskId} {
      allow read: if isSupervisor() || canMaintenanceReadTask(resource.data);
      allow create: if isSupervisor();
      allow update: if isSupervisor() || canMaintenanceUpdateTask();
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isSupervisor() || (
        isAuthenticated() &&
        request.auth.uid == userId &&
        request.resource.data.get('role', 'user') in ['user', 'viewer']
      );
      allow update: if isSupervisor() || (
        isAuthenticated() &&
        request.auth.uid == userId &&
        request.resource.data.get('role', null) == resource.data.get('role', null)
      );
      allow delete: if isAdmin();
    }

    match /devices/{deviceId} {
      allow read: if isAuthenticated();
      allow write: if isSupervisor();
    }

    match /sensors/{sensorId} {
      allow read: if isAuthenticated();
      allow write: if isSupervisor();
    }

    // Top-level collections
    match /alerts/{alertId} {
      allow read: if isAuthenticated();
      allow write: if isSupervisor();
    }

    match /reports/{reportId} {
      allow read: if isAuthenticated();
      allow write: if isSupervisor();
    }

    match /maintenanceNotes/{noteId} {
      allow read: if isAuthenticated();
      allow write: if isMaintenance();
    }

    match /automationRules/{ruleId} {
      allow read: if isAuthenticated();
      allow write: if isSupervisor();
    }

    match /sensorReadings/{readingId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Anonymous issue-report intake is server-only. Administrator moderation
    // also goes through authenticated Admin SDK endpoints, never direct clients.
    match /issueReports/{reportId} {
      allow read, write: if false;

      match /submissions/{submissionId} {
        allow read, write: if false;
      }
    }

    match /publicIssueReportRateLimits/{fingerprintId} {
      allow read, write: if false;
    }

    match /publicIssueReportCooldowns/{cooldownId} {
      allow read, write: if false;
    }

    match /publicIssueReportOpenKeys/{openKeyId} {
      allow read, write: if false;
    }

    match /publicIssueReportEvidenceJobs/{jobId} {
      allow read, write: if false;
    }

    match /publicIssueReportNotificationOutbox/{jobId} {
      allow read, write: if false;
    }
  }
}
