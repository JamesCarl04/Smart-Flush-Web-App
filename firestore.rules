rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function currentUserRole() {
      return isAuthenticated()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    function isAdmin() {
      return currentUserRole() == 'admin';
    }

    function isSupervisor() {
      return currentUserRole() == 'supervisor';
    }

    function isMaintenance() {
      return currentUserRole() == 'maintenance';
    }

    function ownTask() {
      return resource.data.assignedTo == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if isSelf(userId) || isAdmin() || isSupervisor();
      allow create: if isSelf(userId) || isAdmin();
      allow update: if isAdmin()
        || (
          isSelf(userId)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
        );
      allow delete: if isAdmin();

      match /fcmToken/{tokenId} {
        allow read, write: if isSelf(userId) || isAdmin();
      }
    }

    match /tasks/{taskId} {
      allow read: if isAdmin() || isSupervisor() || (isMaintenance() && ownTask());
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (
          isMaintenance()
          && ownTask()
          && request.resource.data.assignedTo == resource.data.assignedTo
        )
        || (
          isSupervisor()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['assignedTo', 'assignedToIds', 'status', 'supervisorUid'])
        );
    }

    match /maintenancePersonnel/{userId} {
      allow read: if isAdmin() || isSupervisor() || isSelf(userId);
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || isSelf(userId)
        || (
          isSupervisor()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['isAvailable'])
        );
    }

    match /supervisorActions/{actionId} {
      allow create: if isSupervisor()
        && request.resource.data.supervisorUid == request.auth.uid;
      allow read: if isAdmin()
        || (isSupervisor() && resource.data.supervisorUid == request.auth.uid);
      allow update, delete: if false;
    }

    match /maintenanceNotes/{noteId} {
      allow read: if isAdmin() || isSupervisor();
      allow create: if isAuthenticated() && currentUserRole() != 'viewer';
      allow update, delete: if false;
    }

    match /devices/{deviceId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
      match /maintenanceCounters/{counterId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin() || isSupervisor();
      }
    }

    match /sensorReadings/{date}/readings/{readingId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /alerts/{alertId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isSupervisor();
    }

    match /automationRules/{ruleId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isSupervisor();
    }

    match /reports/{reportId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /flushEvents/{id} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /lidEvents/{id} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /uvCycles/{id} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
  }
}
