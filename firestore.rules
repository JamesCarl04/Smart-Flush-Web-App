rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isRole(role) {
      return isAuthenticated() && (
        request.auth.token.role == role ||
        getUserData().role == role
      );
    }

    function isAdmin() {
      return isRole('admin');
    }

    function isSupervisor() {
      return isRole('supervisor') || isAdmin();
    }

    function isMaintenance() {
      return isRole('maintenance') || isRole('technician') || isSupervisor();
    }

    match /tasks/{taskId} {
      allow read: if isAuthenticated();
      allow create: if isSupervisor();
      allow update: if isAuthenticated() && (
        isSupervisor() ||
        (
          isMaintenance() &&
          request.resource.data.inspectionStatus != 'approved'
        )
      );
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && (request.auth.uid == userId || isSupervisor());
      allow delete: if isAdmin();
    }

    match /devices/{deviceId} {
      allow read: if isAuthenticated();
      allow write: if isSupervisor();
    }

    match /sensors/{sensorId} {
      allow read: if isAuthenticated();
      allow write: if isSupervisor();
    }
  }
}
