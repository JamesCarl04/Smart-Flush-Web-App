{
  "name": "smart-flush",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-all.js",
    "dev:web": "next dev",
    "dev:listener": "npm --prefix mqtt-listener run dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "jest --watch",
    "test:ci": "jest --coverage --ci",
    "test:integration": "jest --testPathPattern=integration --runInBand",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:security": "npm audit --audit-level=moderate && echo 'Security checks passed'",
    "railway:listener:build": "npm --prefix mqtt-listener install && npm --prefix mqtt-listener run build",
    "railway:listener:start": "npm --prefix mqtt-listener run start:prod"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@react-pdf/renderer": "^4.3.2",
    "@reduxjs/toolkit": "^2.12.0",
    "@types/js-cookie": "^3.0.6",
    "axios": "^1.13.6",
    "date-fns": "^4.1.0",
    "firebase": "^12.10.0",
    "firebase-admin": "^13.7.0",
    "immer": "^11.1.16",
    "js-cookie": "^3.0.5",
    "lucide-react": "^0.577.0",
    "mqtt": "^5.15.0",
    "next": "^16.1.6",
    "nextjs-toploader": "^3.9.17",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "^7.71.2",
    "react-hot-toast": "^2.6.0",
    "recharts": "^3.8.0",
    "redux": "^5.0.1",
    "swr": "^2.4.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@types/jest": "^29.5.11",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "daisyui": "^4.0.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.1.6",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "postcss": "^8",
    "prettier": "^3.8.1",
    "tailwindcss": "^3.4.1",
    "ts-jest": "^29.1.1",
    "typescript": "^5"
  }
}
